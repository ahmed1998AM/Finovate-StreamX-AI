```gitignore
# Dependencies
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment
.env
.env.local
*.env.*

# Logs and temp files
*.log
*.tmp

# Editors
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
dist/
build/
*.egg-info/

# Testing
.coverage
htmlcov/
.coverage.*
.nox/
.tox/

# Python specific
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.ENV
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.hypothesis/

# Web dashboard artifacts
*.css.map
*.js.map
```